# ============================================================
# HML HTTPS: WEB E API (certificado montado somente em runtime)
# ============================================================

server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;

    return 421;
}

server {
    listen 443 ssl;
    server_name frota-contratada.hml.seara.com.br;

    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;

    allow 127.0.0.1;
    allow 10.252.38.205;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
    }
}

server {
    listen 443 ssl;
    server_name api.frota-contratada.hml.seara.com.br;

    ssl_certificate /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;

    allow 127.0.0.1;
    allow 10.252.38.205;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# ============================================================
# DMZ / MOBILE API INGRESS
# ============================================================

server {
    listen 8090;
    server_name _;

    # Teste local
    allow 127.0.0.1;

    # Reverse proxy externo / DMZ
    allow 10.252.38.205;

    # Qualquer outra origem deve ser recusada
    deny all;

    location / {
        proxy_pass http://127.0.0.1:3000;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}


# ============================================================
# DEFAULT / HEALTH
# ============================================================

server {
    listen 80 default_server;
    server_name _;

    location = /health {
        access_log off;
        default_type text/plain;

        return 200 "gateway-ok\n";
    }

    location / {
        return 404;
    }
}
