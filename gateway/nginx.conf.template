# ============================================================
# DEFAULT / HEALTH
# ============================================================

server {
    listen 80 default_server;
    server_name _;

    location = /health {
        access_log off;
        default_type text/plain;

        return 200 "gateway-ok\n";
    }

    location / {
        return 404;
    }
}
